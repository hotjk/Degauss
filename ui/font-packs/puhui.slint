// Personal Simplified Chinese face. Baked at 12px (Slint seed) + 26px (list
// titles) so Smooth / Pixel / Smooth 2 / Pixel 2 never carry Han fallbacks.
import "../../assets/fonts/AlibabaPuHuiTi-3-55-Regular.ttf";
import { Charset } from "charset_han.slint";
export component FontPack inherits Window {
    default-font-family: "Alibaba PuHuiTi 3.0 55 Regular";
    default-font-size: 26px;
    Charset { }
}
